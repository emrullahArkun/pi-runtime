[Plymouth Theme]
Name=BIG
Description=BIG mark with a ring turning around it, like the TV setup page
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/big
HorizontalAlignment=.5
VerticalAlignment=.5
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.5
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0xffffff
BackgroundEndColor=0xffffff
