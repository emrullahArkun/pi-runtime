[Unit]
Description=Wi-Fi setup over the TV when the kiosk has no network
After=NetworkManager.service wifi-fallback.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/big-wifi-setup/wifi_setup.py
# kiosk.sh reads the state file, also after the service has finished.
RuntimeDirectory=big-wifi-setup
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=big-wifi-setup
StateDirectoryMode=0700
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
